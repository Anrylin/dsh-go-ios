# Normalise line endings: every text file is stored and checked out with LF.
# The checkout on Windows otherwise rewrites shell scripts to CRLF, and bash
# then fails on them with "syntax error: unexpected end of file".
* text=auto eol=lf

# Binaries must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.ipa binary
*.xcuserstate binary
*.pbxproj -text
